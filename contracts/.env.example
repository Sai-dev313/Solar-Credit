# Used only when deploying to the Sepolia test network. Never commit a real .env file.
# Hardhat reads these from the terminal, so EXPORT them in the SAME terminal tab before `npm run deploy:sepolia`:
#   export SEPOLIA_RPC_URL=...   export DEPLOYER_PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=
# A throwaway wallet funded from a Sepolia faucet. It becomes the contract OWNER, and the same key is stored as the
# CHAIN_PRIVATE_KEY secret of the chain-sync function. Never use a wallet that holds real money.
DEPLOYER_PRIVATE_KEY=
