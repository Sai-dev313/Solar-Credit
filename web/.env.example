# ---- Real mode (Supabase + public chain) -----------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public JSON-RPC of the chain the contract lives on. The "Verified on blockchain"
# page reads straight from it, independent of our database.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_NAME=Sepolia
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# ---- Offline demo mode (no Supabase needed; data lives in the browser) -----
# VITE_DEMO=1
# Optional: record demo transactions on a local Hardhat node instead of simulating them.
# VITE_DEMO_CHAIN_RPC=http://127.0.0.1:8545
# (This is the public, well-known Hardhat test key for a local node. Never put a real key here.)
# VITE_DEMO_OWNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
